DATABASE_URL=postgresql://seven:seven_dev@localhost:5434/seven_tools
DATABASE_URL_TEST=postgresql://seven_test:seven_test@localhost:5433/seven_tools_test
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:8080,http://localhost:8082,http://localhost:5173,http://localhost:4173,http://127.0.0.1:8080,http://127.0.0.1:8082,http://127.0.0.1:5173,http://127.0.0.1:4173
# Optional regex for preview deployments in staging, for example:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# AI provider. OpenAI-compatible Chat Completions endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=sk-your_openai_api_key_here
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3

# Optional Groq alternative:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk-your_groq_api_key_here

# ClickUp powers the registration company directory.
# Backend endpoint used: GET https://api.clickup.com/api/v2/list/{CLICKUP_CLIENTS_LIST_ID}/task
# The token must have access to the "Carteira de clientes" list.
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_CLIENTS_LIST_ID=your_clickup_clients_list_id_here
SESSION_TTL_DAYS=7
LOGIN_RATE_LIMIT=5/minute

# Password reset links and email delivery.
FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_PROVIDER=log
# Production Resend delivery:
# EMAIL_PROVIDER=resend
EMAIL_FROM=SEVEN Tools <no-reply@sevendigitais.com>
RESEND_API_KEY=
